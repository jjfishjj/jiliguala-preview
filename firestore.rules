rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'guocheju@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /methods/{methodId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if owns(adminId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create, update: if owns(userId);
      allow read: if owns(userId) || isAdmin();
      allow delete: if false;

      match /favorites/{methodId} {
        allow read, create, update, delete: if owns(userId);
      }

      match /practice/{methodId} {
        allow read: if owns(userId) || isAdmin();
        allow create, update: if owns(userId);
        allow delete: if false;
      }

      match /later/{methodId} {
        allow read, create, update, delete: if owns(userId);
      }

      match /notes/{methodId} {
        allow read, create, update, delete: if owns(userId);
      }

      match /daily/{date} {
        allow read: if owns(userId) || isAdmin();
        allow create, update, delete: if owns(userId);
      }

      match /activity/{date} {
        allow read: if owns(userId) || isAdmin();
        allow create, update: if owns(userId);
        allow delete: if false;
      }
    }

    match /leaderboard/{userId} {
      allow read: if request.auth != null && resource.data.optedIn == true;
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(["optedIn", "displayName", "weeklyCount", "weekKey", "updatedAt"])
        && request.resource.data.optedIn == true
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.weeklyCount is int
        && request.resource.data.weeklyCount >= 0
        && request.resource.data.weeklyCount <= 10000
        && request.resource.data.weekKey is string
        && request.resource.data.updatedAt is timestamp;
      allow delete: if owns(userId);
    }

    match /{path=**}/practice/{methodId} {
      allow read: if isAdmin();
    }

    match /{path=**}/activity/{date} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
